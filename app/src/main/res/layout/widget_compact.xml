<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="5dp" android:background="@drawable/widget_bg">
 <LinearLayout android:layout_width="match_parent" android:layout_height="23dp" android:gravity="center_vertical" android:orientation="horizontal">
 <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:singleLine="true" android:ellipsize="end" android:text="Ghi chú nhanh" android:textColor="#F2F6F2" android:textSize="12sp" android:textStyle="bold"/>
 <TextView android:id="@+id/add" android:layout_width="23dp" android:layout_height="23dp" android:gravity="center" android:text="+" android:textSize="20sp" android:includeFontPadding="false" android:textColor="#203C28" android:background="@drawable/plus_bg" android:contentDescription="Thêm nhiệm vụ"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
 <LinearLayout android:id="@+id/row0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
 <ImageView android:id="@+id/check0" android:layout_width="24dp" android:layout_height="match_parent" android:padding="3dp" android:scaleType="centerInside" android:src="@drawable/ic_check" android:contentDescription="Hoàn thành nhiệm vụ"/>
 <TextView android:id="@+id/task0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:singleLine="true" android:ellipsize="end" android:text="Thêm ghi chú" android:textSize="11sp" android:textColor="#F2F6F2"/>
 </LinearLayout>
<LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
 <ImageView android:id="@+id/check1" android:layout_width="24dp" android:layout_height="match_parent" android:padding="3dp" android:scaleType="centerInside" android:src="@drawable/ic_check" android:contentDescription="Hoàn thành nhiệm vụ"/>
 <TextView android:id="@+id/task1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:singleLine="true" android:ellipsize="end" android:text="Thêm ghi chú" android:textSize="11sp" android:textColor="#F2F6F2"/>
 </LinearLayout>
<LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
 <ImageView android:id="@+id/check2" android:layout_width="24dp" android:layout_height="match_parent" android:padding="3dp" android:scaleType="centerInside" android:src="@drawable/ic_check" android:contentDescription="Hoàn thành nhiệm vụ"/>
 <TextView android:id="@+id/task2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:singleLine="true" android:ellipsize="end" android:text="Thêm ghi chú" android:textSize="11sp" android:textColor="#F2F6F2"/>
 </LinearLayout>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="13dp" android:gravity="center_vertical" android:orientation="horizontal">
 <TextView android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:text="0/3" android:textColor="#AABBB0" android:textSize="9sp" android:includeFontPadding="false" android:layout_marginEnd="6dp"/>
 <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="4dp" android:max="3" android:progress="0" android:progressDrawable="@drawable/progress_bg"/>
 </LinearLayout></LinearLayout>